#!/usr/bin/env bash
# ====================================================================
# FPSHUD — Linux Gaming Performance Overlay & Management CLI
# ====================================================================

LIB_SO="@FPSHUD_LIB_PATH@"
if [ ! -f "$LIB_SO" ]; then
    if [ -f "$HOME/.local/lib/fpshud/libfpshud.so" ]; then
        LIB_SO="$HOME/.local/lib/fpshud/libfpshud.so"
    elif [ -f "/usr/local/lib/fpshud/libfpshud.so" ]; then
        LIB_SO="/usr/local/lib/fpshud/libfpshud.so"
    elif [ -f "/usr/lib/fpshud/libfpshud.so" ]; then
        LIB_SO="/usr/lib/fpshud/libfpshud.so"
    fi
fi

show_help() {
    cat <<'EOF'
====================================================================
  FPSHUD — Linux Gaming Performance Overlay & Management CLI
====================================================================
Penggunaan / Usage:
  fpshud <perintah/game> [args...] Launch OpenGL / Vulkan game with overlay
  fpshud --status, -c              Periksa status izin sensor hardware (RAPL CPU Power)
  fpshud --setup, -s               Konfigurasi izin sensor hardware RAPL CPU Power (Sudo opsional)
  fpshud --uninstall               Hapus instalasi FPSHUD secara bersih dari sistem
  fpshud --help, -h                Tampilkan bantuan ini

Contoh / Examples:
  fpshud glxgears
  fpshud %command%                 (Steam Launch Options untuk game OpenGL)
  fpshud --status                  (Periksa apakah CPU Watt terbaca)
  fpshud --setup                   (Beri izin sensor CPU Wattage kapan saja tanpa instal ulang)
  fpshud --uninstall               (Hapus seluruh file overlay, layer, dan bin)
====================================================================
EOF
}

check_status() {
    echo "===================================================================="
    echo "  FPSHUD — Status Izin & Akses Sensor Perangkat Keras"
    echo "===================================================================="

    local rapl_ok=0

    # 1. RAPL CPU Wattage
    for r in /sys/class/powercap/*rapl*/*/energy_uj /sys/class/powercap/*rapl*/energy_uj; do
        if [ -r "$r" ] 2>/dev/null; then
            rapl_ok=1
            break
        fi
    done

    echo -n "  [+] CPU Package Power (RAPL / Watt)   : "
    if [ "$rapl_ok" -eq 1 ]; then
        echo -e "\033[32mAKTIF (Dapat dibaca)\033[0m"
    else
        echo -e "\033[33mTERBATAS (Perlu izin udev / sudo opsional)\033[0m"
    fi

    echo -e "  [+] RAM Usage, Swap & PSI (/proc)     : \033[32mAKTIF (Bebas Sudo)\033[0m"
    echo -e "  [+] Hotkey & Input Toggle (Wayland/X) : \033[32mAKTIF (In-Process Hook, Bebas Sudo)\033[0m"

    echo "--------------------------------------------------------------------"
    if [ "$rapl_ok" -eq 1 ]; then
        echo -e "\033[32mSemua izin sensor hardware lengkap dan siap digunakan!\033[0m"
    else
        echo -e "\033[33mInput & RAM 100% aktif tanpa sudo. Untuk mengaktifkan sensor CPU Wattage (RAPL), jalankan:\033[0m"
        echo "    fpshud --setup"
    fi
    echo "===================================================================="
}

run_setup() {
    echo "===================================================================="
    echo "  FPSHUD — Konfigurasi Izin Sensor Hardware (RAPL CPU Wattage)"
    echo "===================================================================="
    echo "Mengonfigurasi aturan udev standar Linux agar sensor CPU Wattage (RAPL)"
    echo "dapat dibaca oleh user biasa tanpa hak root saat bermain game."
    echo ""
    echo "Perhatian Keamanan / Security Notice (I6):"
    echo "  1. Memberikan izin baca RAPL CPU Watt (MODE 0444) memungkinkan aplikasi lokal"
    echo "     membaca konsumsi daya CPU (potensi side-channel CVE-2020-8694 Platypus)."
    echo "  2. Input hotkeys & RAM telah bebas sudo dan tidak memerlukan izin tambahan."
    echo "--------------------------------------------------------------------"

    local user_consent=0
    if [ "${FORCE_SETUP:-0}" = "1" ] || [ "${1:-}" = "-y" ] || [ "${1:-}" = "--yes" ]; then
        user_consent=1
    elif [ -t 0 ]; then
        read -r -p "Lanjutkan konfigurasi izin ini? / Proceed with setup? [y/N] " confirm || confirm="n"
        case "$confirm" in
            [yY][eE][sS]|[yY]) user_consent=1 ;;
            *) echo "Konfigurasi dibatalkan oleh pengguna."; return 0 ;;
        esac
    elif [ -r /dev/tty ] && [ -w /dev/tty ]; then
        read -r -p "Lanjutkan konfigurasi izin ini? / Proceed with setup? [y/N] " confirm < /dev/tty || confirm="n"
        case "$confirm" in
            [yY][eE][sS]|[yY]) user_consent=1 ;;
            *) echo "Konfigurasi dibatalkan oleh pengguna."; return 0 ;;
        esac
    else
        echo "[!] Non-interactive environment detected without TTY. To run setup, use: fpshud --setup -y"
        return 1
    fi

    local SUDO_CMD="sudo"
    if [ "$EUID" -eq 0 ]; then
        SUDO_CMD=""
    else
        if ! command -v sudo >/dev/null 2>&1; then
            echo "[!] Perintah 'sudo' tidak ditemukan pada sistem ini."
            exit 1
        fi
        echo "[*] Meminta izin administrator (sudo)..."
        if ! sudo -v; then
            echo "[!] Gagal mendapatkan izin sudo. Konfigurasi dibatalkan."
            exit 1
        fi
    fi

    # 1. RAPL CPU Wattage udev rule (scoped to 'render' group 0440 instead of world-readable 0444)
    echo "[*] Memasang udev rule untuk CPU Wattage (/etc/udev/rules.d/99-fpshud-rapl.rules)..."
    $SUDO_CMD bash -c 'cat > /etc/udev/rules.d/99-fpshud-rapl.rules << "EOF"
SUBSYSTEM=="powercap", ACTION=="add|change", KERNEL=="*rapl*", ATTR{energy_uj}!="", GROUP="render", MODE="0440"
SUBSYSTEM=="powercap", ACTION=="add|change", KERNEL=="*rapl:*", ATTR{energy_uj}!="", GROUP="render", MODE="0440"
EOF'
    $SUDO_CMD chmod 644 /etc/udev/rules.d/99-fpshud-rapl.rules 2>/dev/null || true

    # 2. Reload udev rules
    echo "[*] Me-reload aturan udev sistem..."
    $SUDO_CMD udevadm control --reload-rules 2>/dev/null || true
    $SUDO_CMD udevadm trigger --subsystem-match=powercap 2>/dev/null || true

    # 3. Flatpak Steam configuration
    TARGET_HOME="${HOME}"
    TARGET_USER="${SUDO_USER:-$USER}"
    if [ -n "$SUDO_USER" ]; then
        USER_HOME="$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6)"
        [ -n "$USER_HOME" ] && TARGET_HOME="$USER_HOME"
    fi
    FLATPAK_STEAM_DIR="$TARGET_HOME/.var/app/com.valvesoftware.Steam"
    if [ -d "$FLATPAK_STEAM_DIR" ]; then
        echo "[*] Mendeteksi direktori Flatpak Steam: $FLATPAK_STEAM_DIR"
        if command -v flatpak >/dev/null 2>&1; then
            if [ -n "$SUDO_USER" ] && [ "$EUID" -eq 0 ]; then
                su - "$SUDO_USER" -c 'flatpak override --user --filesystem="$HOME/.local/lib/fpshud:ro" --filesystem=xdg-config/fpshud:create --filesystem=xdg-data/fpshud:ro com.valvesoftware.Steam' 2>/dev/null || true
            else
                flatpak override --user --filesystem="$HOME/.local/lib/fpshud:ro" --filesystem=xdg-config/fpshud:create --filesystem=xdg-data/fpshud:ro com.valvesoftware.Steam 2>/dev/null || true
            fi
        fi
        VK_SRC="${XDG_DATA_HOME:-$TARGET_HOME/.local/share}/vulkan/implicit_layer.d/VkLayer_FPSHUD_overlay.json"
        VK_DST="$FLATPAK_STEAM_DIR/data/vulkan/implicit_layer.d"
        mkdir -p "$VK_DST" 2>/dev/null || true
        if [ -f "$VK_SRC" ]; then
            cp -f "$VK_SRC" "$VK_DST/VkLayer_FPSHUD_overlay.json" 2>/dev/null || true
            if [ -n "$TARGET_USER" ]; then
                $SUDO_CMD chown -R "$TARGET_USER:" "$VK_DST" 2>/dev/null || true
            fi
        fi
        echo "    [+] Izin dan Vulkan implicit layer Flatpak Steam berhasil dikonfigurasi."
    fi

    echo ""
    echo "===================================================================="
    echo "  [✓] Konfigurasi Izin Sensor Berhasil Selesai!"
    echo "===================================================================="
    echo "Catatan: Sensor CPU Wattage (RAPL) telah aktif."
    echo "Input dan RAM bekerja 100% tanpa hak akses khusus (sudo-free)."
    echo "===================================================================="
}

case "$1" in
    --help|-h|help)
        show_help
        exit 0
        ;;
    --status|-c|status|check)
        check_status
        exit 0
        ;;
    --setup|-s|setup)
        run_setup
        exit 0
        ;;
    --uninstall|uninstall)
        UNINSTALL_SH="${HOME}/.local/lib/fpshud/uninstall.sh"
        if [ -f "$UNINSTALL_SH" ]; then
            exec bash "$UNINSTALL_SH"
        fi
        SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
        if [ -f "$SCRIPT_DIR/uninstall.sh" ]; then
            exec bash "$SCRIPT_DIR/uninstall.sh"
        fi
        if command -v curl >/dev/null 2>&1; then
            exec bash -c 'curl -fsSL https://raw.githubusercontent.com/budicuy/FPS_HUD_FOR_LINUX/main/uninstall.sh | bash'
        fi
        echo "[!] ERROR: Uninstallation script not found and curl is unavailable." >&2
        exit 1
        ;;
    *)
        if [ $# -eq 0 ]; then
            show_help
            exit 1
        fi
        ;;
esac

# Resolve target binary to check for ELF32
TARGET_BIN="$1"
if [ ! -f "$TARGET_BIN" ]; then
    RESOLVED_BIN="$(command -v "$1" 2>/dev/null || true)"
    if [ -n "$RESOLVED_BIN" ] && [ -f "$RESOLVED_BIN" ]; then
        TARGET_BIN="$RESOLVED_BIN"
    fi
fi

IS_ELF32=0
if [ -f "$TARGET_BIN" ] && [ -r "$TARGET_BIN" ]; then
    MAGIC_5="$(od -An -tx1 -N5 "$TARGET_BIN" 2>/dev/null | tr -d ' \n')"
    if [ "$MAGIC_5" = "7f454c4601" ]; then
        IS_ELF32=1
    fi
fi

if [ "$IS_ELF32" -eq 1 ]; then
    echo "[INFO] Target binary is 32-bit ELF (ELFCLASS32); skipping 64-bit FPSHUD overlay injection."
    exec "$@"
fi

# Check if libfpshud.so requires AddressSanitizer runtime.
# If so, the ASan runtime DSO MUST be placed strictly FIRST in LD_PRELOAD
# before any instrumented shared objects or application binaries.
ASAN_RT=""
if [ -f "$LIB_SO" ] && command -v readelf >/dev/null 2>&1; then
    if readelf -d "$LIB_SO" 2>/dev/null | grep -E "NEEDED.*libasan\.so" >/dev/null 2>&1; then
        # Built with GCC AddressSanitizer
        NEEDED_ASAN="$(readelf -d "$LIB_SO" 2>/dev/null | grep NEEDED | grep -o -E 'libasan\.so(\.[0-9]+)?' | head -n1 || true)"
        for CC_BIN in "${CC:-}" "${CXX:-}" gcc-16 gcc-15 gcc; do
            if [ -n "$CC_BIN" ] && command -v "$CC_BIN" >/dev/null 2>&1; then
                [ -n "$NEEDED_ASAN" ] && ASAN_RT="$("$CC_BIN" -print-file-name="$NEEDED_ASAN" 2>/dev/null || true)"
                [ -f "$ASAN_RT" ] && break
                ASAN_RT="$("$CC_BIN" -print-file-name=libasan.so 2>/dev/null || true)"
                [ -f "$ASAN_RT" ] && break
            fi
        done
        if [ -z "$ASAN_RT" ] || [ ! -f "$ASAN_RT" ]; then
            ASAN_RT="$(ldconfig -p 2>/dev/null | grep -E 'libasan\.so(\.[0-9]+)?' | grep -v 'lib32' | awk '{print $NF}' | head -n1 || true)"
        fi
        if [ -z "$ASAN_RT" ] || [ ! -f "$ASAN_RT" ]; then
            ASAN_RT="${NEEDED_ASAN:-libasan.so}"
        fi
    elif readelf -d "$LIB_SO" 2>/dev/null | grep -E "NEEDED.*libclang_rt\.asan" >/dev/null 2>&1 || readelf -s "$LIB_SO" 2>/dev/null | grep -q "__asan_"; then
        # Built with Clang AddressSanitizer
        for CC_BIN in "${CC:-}" "${CXX:-}" clang-19 clang; do
            if [ -n "$CC_BIN" ] && command -v "$CC_BIN" >/dev/null 2>&1; then
                ASAN_RT="$("$CC_BIN" -print-file-name=libclang_rt.asan-x86_64.so 2>/dev/null || true)"
                [ -f "$ASAN_RT" ] && break
            fi
        done
    fi
fi

# Launch game with LD_PRELOAD
if [ -z "$FPS_HUD" ]; then
    export FPS_HUD=1
fi
export LD_LIBRARY_PATH="$(dirname "$LIB_SO")${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
if [ -n "$ASAN_RT" ] && [ -f "$ASAN_RT" ]; then
    export LD_PRELOAD="${ASAN_RT}:libfpshud.so${LD_PRELOAD:+:$LD_PRELOAD}"
else
    export LD_PRELOAD="libfpshud.so${LD_PRELOAD:+:$LD_PRELOAD}"
fi

exec "$@"
