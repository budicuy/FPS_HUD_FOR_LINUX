#!/usr/bin/env bash
# ====================================================================
# FPSHUD — Linux Gaming Performance Overlay & Management CLI
# ====================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_SO="@FPSHUD_LIB_PATH@"
if [ ! -f "$LIB_SO" ]; then
    if [ -f "$SCRIPT_DIR/libfpshud.so" ]; then
        LIB_SO="$SCRIPT_DIR/libfpshud.so"
    elif [ -f "$HOME/.local/lib/fpshud/libfpshud.so" ]; then
        LIB_SO="$HOME/.local/lib/fpshud/libfpshud.so"
    elif [ -f "/usr/local/lib/fpshud/libfpshud.so" ]; then
        LIB_SO="/usr/local/lib/fpshud/libfpshud.so"
    elif [ -f "/usr/lib/fpshud/libfpshud.so" ]; then
        LIB_SO="/usr/lib/fpshud/libfpshud.so"
    fi
fi

show_help() {
    cat <<'EOF'
====================================================================
  FPSHUD — Linux Gaming Performance Overlay & Management CLI
====================================================================
Usage:
  fpshud <command/game> [args...]  Launch OpenGL / Vulkan game with overlay
  fpshud --status, -c              Check hardware sensor permissions & availability
  fpshud --setup, -s               Configure hardware sensor permissions (RAPL CPU Power, sudo optional)
  fpshud --uninstall               Cleanly uninstall FPSHUD from system
  fpshud --help, -h                Show this help message

Examples:
  fpshud glxgears
  fpshud %command%                 (Steam Launch Options for Proton & Native games)
  fpshud --status                  (Check hardware sensor readability)
  fpshud --setup                   (Grant CPU Wattage sensor permissions anytime without reinstalling)
  fpshud --uninstall               (Cleanly remove all overlay files, layers, and binaries)
====================================================================
EOF
}

check_status() {
    local SCRIPT_DIR_LOCAL
    SCRIPT_DIR_LOCAL="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    local LIB_DIR_LOCAL
    LIB_DIR_LOCAL="$(dirname "$LIB_SO")"
    for candidate in \
        "$LIB_DIR_LOCAL/fpshud_test" \
        "$HOME/.local/lib/fpshud/fpshud_test" \
        "$SCRIPT_DIR_LOCAL/fpshud_test" \
        "$SCRIPT_DIR_LOCAL/../build/fpshud_test"; do
        if [ -x "$candidate" ] && grep -aq -- "--probe-sensors" "$candidate" 2>/dev/null; then
            "$candidate" --probe-sensors
            return 0
        fi
    done

    echo "===================================================================="
    echo "  FPSHUD — Hardware Sensor Permissions & Access Status"
    echo "===================================================================="

    local rapl_ok=0
    local input_ok=0

    # 1. RAPL CPU Wattage
    for r in /sys/class/powercap/*rapl*/*/energy_uj /sys/class/powercap/*rapl*/energy_uj; do
        if [ -r "$r" ] 2>/dev/null; then
            rapl_ok=1
            break
        fi
    done

    # 2. Evdev input devices
    for ev in /dev/input/event*; do
        if [ -r "$ev" ] 2>/dev/null; then
            input_ok=1
            break
        fi
    done

    echo -n "  [+] CPU Package Power (RAPL / Watt)   : "
    if [ "$rapl_ok" -eq 1 ]; then
        echo -e "\033[32mAVAILABLE (Direct RAPL Counter)\033[0m"
    else
        echo -e "\033[32mAVAILABLE (TDP Dynamic Estimation - Sudo-Free)\033[0m"
    fi

    echo -e "  [+] RAM Usage, Swap & PSI (/proc)     : \033[32mAVAILABLE (Sudo-Free)\033[0m"
    echo -n "  [+] Kernel Mouse Grab (Zero Bleed)    : "
    if [ "$input_ok" -eq 1 ]; then
        echo -e "\033[32mAVAILABLE (Direct Evdev Hardware Grab)\033[0m"
    else
        echo -e "\033[33mLIMITED (Fallback Mode - Run 'fpshud --setup' to enable Kernel Grab)\033[0m"
    fi

    echo "--------------------------------------------------------------------"
    if [ "$rapl_ok" -eq 1 ] && [ "$input_ok" -eq 1 ]; then
        echo -e "\033[32mAll hardware sensor and input grab permissions are complete and ready to use!\033[0m"
    else
        echo -e "\033[33mTo enable direct CPU Wattage (RAPL) and Kernel Mouse Grab, run:\033[0m"
        echo "    fpshud --setup"
    fi
    echo "===================================================================="
}

run_setup() {
    echo "===================================================================="
    echo "  FPSHUD — Hardware Sensor Permissions Setup (RAPL CPU Wattage)"
    echo "===================================================================="
    echo "Configuring standard Linux udev rules so that CPU Wattage (RAPL)"
    echo "can be read by unprivileged users without root privileges during gaming."
    echo ""
    echo "Security Notice (I6):"
    echo "  1. Granting read access to RAPL CPU Watt (GROUP=\"render\", MODE=\"0440\") allows"
    echo "     members of the 'render' group to read CPU energy counters (CVE-2020-8694 Platypus trade-off)."
    echo "  2. What sudo does: writes /etc/udev/rules.d/99-fpshud-rapl.rules (mode 0440)"
    echo "     and executes 'udevadm control --reload-rules'. Without sudo, FPSHUD automatically"
    echo "     uses safe TDP + CPU frequency estimation (never stuck at 0W)."
    echo "  3. Granting input group access (MODE=\"0664\", GROUP=\"input\") enables exclusive"
    echo "     kernel-level hardware mouse grab (EVIOCGRAB), eliminating double cursor and click bleed."
    echo "--------------------------------------------------------------------"

    local user_consent=0
    if [ "${FORCE_SETUP:-0}" = "1" ] || [ "${1:-}" = "-y" ] || [ "${1:-}" = "--yes" ]; then
        user_consent=1
    elif [ -t 0 ]; then
        read -r -p "Proceed with sensor permissions setup? [y/N] " confirm || confirm="n"
        case "$confirm" in
            [yY][eE][sS]|[yY]) user_consent=1 ;;
            *) echo "Setup cancelled by user."; return 0 ;;
        esac
    elif [ -r /dev/tty ] && [ -w /dev/tty ]; then
        read -r -p "Proceed with sensor permissions setup? [y/N] " confirm < /dev/tty || confirm="n"
        case "$confirm" in
            [yY][eE][sS]|[yY]) user_consent=1 ;;
            *) echo "Setup cancelled by user."; return 0 ;;
        esac
    else
        echo "[!] Non-interactive environment detected without TTY. To run setup, use: fpshud --setup -y"
        return 1
    fi

    local SUDO_CMD="sudo"
    if [ "$EUID" -eq 0 ]; then
        SUDO_CMD=""
    else
        if ! command -v sudo >/dev/null 2>&1; then
            echo "[!] 'sudo' command not found on this system."
            exit 1
        fi
        echo "[*] Requesting administrator permissions (sudo)..."
        if ! sudo -v; then
            echo "[!] Failed to acquire sudo permissions. Setup cancelled."
            exit 1
        fi
    fi

    # 1. RAPL CPU Wattage udev rule (scoped to 'render' group 0440 instead of world-readable 0444)
    echo "[*] Installing udev rule for CPU Wattage (/etc/udev/rules.d/99-fpshud-rapl.rules)..."
    $SUDO_CMD bash -c 'cat > /etc/udev/rules.d/99-fpshud-rapl.rules << "EOF"
SUBSYSTEM=="powercap", ACTION=="add|change", KERNEL=="*rapl*", ATTR{energy_uj}!="", GROUP="render", MODE="0440"
SUBSYSTEM=="powercap", ACTION=="add|change", KERNEL=="*rapl:*", ATTR{energy_uj}!="", GROUP="render", MODE="0440"
EOF'
    $SUDO_CMD chmod 644 /etc/udev/rules.d/99-fpshud-rapl.rules 2>/dev/null || true

    # 2. Reload udev rules
    echo "[*] Reloading system udev rules..."
    $SUDO_CMD udevadm control --reload-rules 2>/dev/null || true
    $SUDO_CMD udevadm trigger --subsystem-match=powercap 2>/dev/null || true

    # 3. Flatpak Steam configuration
    TARGET_HOME="${HOME}"
    TARGET_USER="${SUDO_USER:-$USER}"
    if [ -n "$SUDO_USER" ]; then
        USER_HOME="$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6)"
        [ -n "$USER_HOME" ] && TARGET_HOME="$USER_HOME"
    fi
    FLATPAK_STEAM_DIR="$TARGET_HOME/.var/app/com.valvesoftware.Steam"
    if [ -d "$FLATPAK_STEAM_DIR" ]; then
        echo "[*] Detected Flatpak Steam directory: $FLATPAK_STEAM_DIR"
        if command -v flatpak >/dev/null 2>&1; then
            if [ -n "$SUDO_USER" ] && [ "$EUID" -eq 0 ]; then
                su - "$SUDO_USER" -c 'flatpak override --user --filesystem="$HOME/.local/lib/fpshud:ro" --filesystem=xdg-config/fpshud:create --filesystem=xdg-data/fpshud:ro com.valvesoftware.Steam' 2>/dev/null || true
            else
                flatpak override --user --filesystem="$HOME/.local/lib/fpshud:ro" --filesystem=xdg-config/fpshud:create --filesystem=xdg-data/fpshud:ro com.valvesoftware.Steam 2>/dev/null || true
            fi
        fi
        VK_SRC="${XDG_DATA_HOME:-$TARGET_HOME/.local/share}/vulkan/implicit_layer.d/VkLayer_FPSHUD_overlay.json"
        VK_DST="$FLATPAK_STEAM_DIR/data/vulkan/implicit_layer.d"
        if [ -n "$SUDO_USER" ] && [ "$EUID" -eq 0 ]; then
            su - "$SUDO_USER" -c "mkdir -p '$VK_DST' && [ -f '$VK_SRC' ] && cp -f '$VK_SRC' '$VK_DST/VkLayer_FPSHUD_overlay.json'" 2>/dev/null || true
        else
            mkdir -p "$VK_DST" 2>/dev/null || true
            if [ -f "$VK_SRC" ]; then
                cp -f "$VK_SRC" "$VK_DST/VkLayer_FPSHUD_overlay.json" 2>/dev/null || true
            fi
        fi
        echo "    [+] Flatpak Steam permissions and Vulkan implicit layer configured successfully."
    fi

    echo ""
    echo "===================================================================="
    echo "  [✓] Sensor Permissions Setup Completed Successfully!"
    echo "===================================================================="
    echo "Note: CPU Wattage (RAPL) sensor is now active."
    echo "Input and RAM operate 100% without special privileges (sudo-free)."
    echo "===================================================================="
    check_status
}

case "$1" in
    --help|-h|help)
        show_help
        exit 0
        ;;
    --version|-v|version)
        echo "FPSHUD v1.3.0 (ISO C++26 Low-Overhead Vulkan/OpenGL Overlay)"
        exit 0
        ;;
    --status|-c|status|check)
        check_status
        exit 0
        ;;
    --setup|-s|setup)
        run_setup
        exit 0
        ;;
    --uninstall|uninstall)
        shift || true
        UNINSTALL_SH="${HOME}/.local/lib/fpshud/uninstall.sh"
        if [ -f "$UNINSTALL_SH" ]; then
            exec bash "$UNINSTALL_SH" "$@"
        fi
        SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
        if [ -f "$SCRIPT_DIR/uninstall.sh" ]; then
            exec bash "$SCRIPT_DIR/uninstall.sh" "$@"
        fi
        echo "[!] ERROR: Local uninstallation script not found at $UNINSTALL_SH or $SCRIPT_DIR/uninstall.sh." >&2
        exit 1
        ;;
    *)
        if [ $# -eq 0 ]; then
            show_help
            exit 1
        fi
        ;;
esac

# Resolve target binary to check for ELF32
TARGET_BIN="$1"
if [ ! -f "$TARGET_BIN" ]; then
    RESOLVED_BIN="$(command -v "$1" 2>/dev/null || true)"
    if [ -n "$RESOLVED_BIN" ] && [ -f "$RESOLVED_BIN" ]; then
        TARGET_BIN="$RESOLVED_BIN"
    fi
fi

IS_ELF32=0
if [ -f "$TARGET_BIN" ] && [ -r "$TARGET_BIN" ]; then
    MAGIC_5="$(od -An -tx1 -N5 "$TARGET_BIN" 2>/dev/null | tr -d ' \n')"
    if [ "$MAGIC_5" = "7f454c4601" ]; then
        IS_ELF32=1
    fi
fi

if [ "$IS_ELF32" -eq 1 ]; then
    echo "[INFO] Target binary is 32-bit ELF (ELFCLASS32); skipping 64-bit FPSHUD overlay injection."
    exec "$@"
fi

# Check if libfpshud.so requires AddressSanitizer runtime.
# If so, the ASan runtime DSO MUST be placed strictly FIRST in LD_PRELOAD
# before any instrumented shared objects or application binaries.
ASAN_RT=""
if [ -f "$LIB_SO" ] && command -v readelf >/dev/null 2>&1; then
    if readelf -d "$LIB_SO" 2>/dev/null | grep -E "NEEDED.*libclang_rt\.asan" >/dev/null 2>&1 || readelf -s "$LIB_SO" 2>/dev/null | grep -q "__asan_"; then
        # Built with Clang AddressSanitizer
        for CC_BIN in "${CC:-}" "${CXX:-}" clang++ clang clang++-23 clang-23 clang++-20 clang-20 clang++-19 clang-19; do
            if [ -n "$CC_BIN" ] && command -v "$CC_BIN" >/dev/null 2>&1; then
                ASAN_RT="$("$CC_BIN" -print-file-name=libclang_rt.asan-x86_64.so 2>/dev/null || true)"
                [ -n "$ASAN_RT" ] && [ -f "$ASAN_RT" ] && break
            fi
        done
        if [ -z "$ASAN_RT" ] || [ ! -f "$ASAN_RT" ]; then
            ASAN_RT="$(ldconfig -p 2>/dev/null | grep -E 'libclang_rt\.asan' | grep -v 'lib32' | awk '{print $NF}' | head -n1 || true)"
        fi
    fi
fi

# Launch game with LD_PRELOAD
if [ ! -f "$LIB_SO" ]; then
    echo "[!] ERROR: libfpshud.so not found at '$LIB_SO' or standard paths." >&2
    echo "    Please verify FPSHUD installation before launching games." >&2
    exit 1
fi

if [ -z "$FPS_HUD" ]; then
    export FPS_HUD=1
fi
LIB_DIR="$(dirname "$LIB_SO")"
if [ -n "$LIB_DIR" ] && [ "$LIB_DIR" != "." ]; then
    export LD_LIBRARY_PATH="$LIB_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
if [ -n "$ASAN_RT" ] && [ -f "$ASAN_RT" ]; then
    export LD_PRELOAD="${ASAN_RT}:$LIB_SO${LD_PRELOAD:+:$LD_PRELOAD}"
else
    export LD_PRELOAD="$LIB_SO${LD_PRELOAD:+:$LD_PRELOAD}"
fi

exec "$@"
