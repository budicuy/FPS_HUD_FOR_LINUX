{
    "file_format_version": "1.2.1",
    "layer": {
        "name": "VK_LAYER_FPSHUD_overlay",
        "type": "GLOBAL",
        "library_path": "@FPSHUD_LIB_PATH@",
        "api_version": "1.3.0",
